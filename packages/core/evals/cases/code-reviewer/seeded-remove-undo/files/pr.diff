diff --git a/src/reading-list.ts b/src/reading-list.ts
--- a/src/reading-list.ts
+++ b/src/reading-list.ts
@@ -29,6 +29,30 @@ export function toggle(list: ReadingList, id: number): ReadingList {
   return { ...list, items: list.items.map(item => (item.id === id ? { ...item, read: !item.read } : item)) }
 }
 
+export interface Removed {
+  item: Item
+  index: number
+}
+
+// Removes a book and returns what's needed to undo it.
+export function remove(list: ReadingList, id: number): { list: ReadingList, removed: Removed | null } {
+  const index = list.items.findIndex(item => item.id === id)
+  if (index === -1) return { list, removed: null }
+  const item = list.items[index]
+  list.items.splice(index, 1)
+  return { list, removed: { item, index } }
+}
+
+// Puts a removed book back where it was.
+export function undo(list: ReadingList, removed: Removed): ReadingList {
+  const items = [ ...list.items ]
+  items.splice(removed.index, 0, removed.item)
+  return { ...list, items }
+}
+
+function countUnread(list: ReadingList): number {
+  return list.items.filter(item => !item.read).length
+}
+
 export function visible(list: ReadingList, filter: Filter): Item[] {
   if (filter === 'all') return list.items
   return list.items.filter(item => item.read === (filter === 'read'))
@@ -36,6 +60,6 @@ export function visible(list: ReadingList, filter: Filter): Item[] {
 
 export function summary(list: ReadingList): string {
-  const unread = list.items.filter(item => !item.read).length
+  const unread = countUnread(list)
   return `${unread} of ${list.items.length} unread`
 }
diff --git a/src/reading-list.test.ts b/src/reading-list.test.ts
--- a/src/reading-list.test.ts
+++ b/src/reading-list.test.ts
@@ -1,3 +1,17 @@
+import { add, empty, remove, undo } from './reading-list'
+
+test('remove then undo restores the book', () => {
+  let list = add(add(empty(), 'Dune'), 'Emma')
+  const result = remove(list, 1)
+  list = undo(result.list, result.removed!)
+  expect(list.items.map(item => item.title)).toEqual([ 'Dune', 'Emma' ])
+})
