+// Marks every book read, or every book unread if the first one is already read.
+export function toggleAll(list: ReadingList): ReadingList {
+  const read = !list.items[0].read
+  return { ...list, items: list.items.map(item => ({ ...item, read })) }
+}
+
 export function visible(list: ReadingList, filter: Filter): Item[] {
   if (filter === 'all') return list.items
   return list.items.filter(item => item.read === (filter === 'read'))
