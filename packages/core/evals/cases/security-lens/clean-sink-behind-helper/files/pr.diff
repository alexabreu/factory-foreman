+++ b/src/html.test.ts
@@ -0,0 +1,6 @@
+import { html } from './html'
+
+it('escapes every inserted value', () => {
+  expect(html`<b>${'<img src=x onerror=alert(1)>'}</b>`).toBe('<b>&lt;img src=x onerror=alert(1)&gt;</b>')
+  expect(html`<a title="${'" onmouseover="x'}">`).toBe('<a title="&quot; onmouseover=&quot;x">')
+})
