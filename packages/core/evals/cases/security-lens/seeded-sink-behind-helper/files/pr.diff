new file mode 100644
--- /dev/null
+++ b/src/html.ts
@@ -0,0 +1,7 @@
+// Builds markup from a template. Values are cleaned before they're inserted.
+export function html(strings: TemplateStringsArray, ...values: unknown[]): string {
+  return strings.reduce((out, s, i) => out + s + (i < values.length ? clean(values[i]) : ''), '')
+}
+
+const clean = (v: unknown) => String(v ?? '').trim()
