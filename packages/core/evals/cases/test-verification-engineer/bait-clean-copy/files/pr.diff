diff --git a/src/reading-list.ts b/src/reading-list.ts
--- a/src/reading-list.ts
+++ b/src/reading-list.ts
@@ -29,6 +29,15 @@ export function toggle(list: ReadingList, id: number): ReadingList {
   return { ...list, items: list.items.map(item => (item.id === id ? { ...item, read: !item.read } : item)) }
 }
 
+// Moves a book one place up the list. The first book stays where it is.
+export function moveUp(list: ReadingList, id: number): ReadingList {
+  const index = list.items.findIndex(item => item.id === id)
+  if (index <= 0) return list
+  const items = [ ...list.items ]
+  items.splice(index - 1, 2, items[index], items[index - 1])
+  return { ...list, items }
+}
+
 export function visible(list: ReadingList, filter: Filter): Item[] {
   if (filter === 'all') return list.items
   return list.items.filter(item => item.read === (filter === 'read'))
diff --git a/src/reading-list.test.ts b/src/reading-list.test.ts
--- a/src/reading-list.test.ts
+++ b/src/reading-list.test.ts
@@ -1,3 +1,22 @@
+import { add, empty, moveUp } from './reading-list'
+
+const titles = (list: ReturnType<typeof empty>) => list.items.map(item => item.title)
+
+test('AC-1: moving "Emma" up puts it above "Dune"', () => {
+  const list = add(add(empty(), 'Dune'), 'Emma')
+  expect(titles(moveUp(list, 2))).toEqual([ 'Emma', 'Dune' ])
+})
+
+test('AC-2: the first book stays first, and the list is unchanged', () => {
+  const list = add(add(empty(), 'Dune'), 'Emma')
+  expect(moveUp(list, 1)).toBe(list)
+})
+
+test('AC-3: an unknown id leaves the list unchanged', () => {
+  const list = add(empty(), 'Dune')
+  expect(moveUp(list, 99)).toBe(list)
+})
